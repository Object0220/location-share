<!-- 首页 - C端车主入口 -->
<view class="page">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="bg-blob bg-blob-1"></view>
    <view class="bg-blob bg-blob-2"></view>
    <view class="bg-blob bg-blob-3"></view>
    <view class="bg-circle bg-circle-1"></view>
    <view class="bg-circle bg-circle-2"></view>
    <view class="bg-grid"></view>
  </view>

  <!-- 顶部品牌区 -->
  <view class="header">
    <view class="hero-badge">
      <text class="hero-icon">🚗</text>
    </view>
    <text class="header-title">道路救援</text>
    <text class="header-subtitle">救援车辆正在赶来，实时查看位置与进度</text>
  </view>

  <!-- 主功能区 -->
  <view class="main-content">
    <view class="entry-card" bindtap="onJoinRoom" hover-class="entry-card--hover">
      <view class="entry-icon">📍</view>
      <view class="entry-body">
        <text class="entry-title">我是车主</text>
        <text class="entry-desc">输入您的手机号后四位，查看救援进度</text>
      </view>
      <view class="entry-arrow">›</view>
    </view>
    <text class="entry-hint">司机师傅会告知您手机号后四位</text>
  </view>

  <!-- 服务状态条（已隐藏） -->
  <view class="status-bar status-{{statusType}}" wx:if="{{false}}">
    <text class="status-dot"></text>
    <text class="status-text">{{debugMsg}}</text>
    <view class="status-retry" wx:if="{{showRetry}}" bindtap="onRetryInit">重试</view>
  </view>
</view>
