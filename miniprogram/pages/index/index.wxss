/** 首页样式 - C端车主入口（浅色简约） */
.page {
  min-height: 100vh;
  background: linear-gradient(160deg, #f6f9ff 0%, #eef4fc 45%, #e9f7f0 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 28px;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

/* 柔和彩色光晕（浅底低饱和） */
.bg-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(70px);
  opacity: 0.5;
}

.bg-blob-1 {
  width: 300px;
  height: 300px;
  background: radial-gradient(circle at 30% 30%, #bcdcff, #9ec9ff);
  top: -100px;
  right: -110px;
}

.bg-blob-2 {
  width: 260px;
  height: 260px;
  background: radial-gradient(circle at 30% 30%, #b6f0d4, #8fe3bd);
  bottom: -50px;
  left: -100px;
}

.bg-blob-3 {
  width: 220px;
  height: 220px;
  background: radial-gradient(circle at 30% 30%, #ffe6b0, #ffd089);
  top: 42%;
  left: 52%;
  opacity: 0.4;
}

/* 半透明描边光环 */
.bg-circle {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(20, 42, 91, 0.06);
  background: rgba(255, 255, 255, 0.4);
}

.bg-circle-1 {
  width: 300px;
  height: 300px;
  top: -80px;
  right: -80px;
}

.bg-circle-2 {
  width: 200px;
  height: 200px;
  bottom: 60px;
  left: -60px;
}

/* 细微网格点缀 */
.bg-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(20, 42, 91, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(20, 42, 91, 0.04) 1px, transparent 1px);
  background-size: 28px 28px;
  opacity: 0.7;
}

/* 顶部品牌区 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 110px;
  padding-bottom: 36px;
  text-align: center;
  z-index: 1;
}

.hero-badge {
  width: 68px;
  height: 68px;
  border-radius: 22px;
  background: rgba(7, 193, 96, 0.12);
  border: 1px solid rgba(7, 193, 96, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  backdrop-filter: blur(8px);
  box-shadow: 0 8px 24px rgba(7, 193, 96, 0.15);
}

.hero-icon {
  font-size: 34px;
  line-height: 1;
}

.header-title {
  font-size: 34px;
  font-weight: 700;
  color: #1a2433;
  letter-spacing: 1px;
  margin-bottom: 10px;
}

.header-subtitle {
  font-size: 15px;
  color: rgba(26, 42, 91, 0.55);
  line-height: 1.5;
}

/* 主功能区 */
.main-content {
  width: 100%;
  max-width: 360px;
  z-index: 1;
}

.entry-card {
  position: relative;
  background: #ffffff;
  border: 1px solid rgba(20, 42, 91, 0.05);
  border-radius: 22px;
  padding: 22px 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: 0 8px 26px rgba(20, 42, 91, 0.08);
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.entry-card--hover {
  transform: scale(0.975);
  box-shadow: 0 4px 16px rgba(20, 42, 91, 0.12);
}

.entry-card:active {
  transform: scale(0.975);
}

.entry-icon {
  width: 54px;
  height: 54px;
  border-radius: 16px;
  background: rgba(7, 193, 96, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  flex-shrink: 0;
}

.entry-body {
  flex: 1;
  min-width: 0;
}

.entry-title {
  font-size: 18px;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 6px;
}

.entry-desc {
  font-size: 13px;
  color: #99a0ad;
  display: block;
  line-height: 1.4;
}

.entry-arrow {
  font-size: 26px;
  color: #c8ccd4;
  flex-shrink: 0;
}

.entry-hint {
  display: block;
  text-align: center;
  margin-top: 16px;
  font-size: 12px;
  color: rgba(26, 42, 91, 0.4);
}

/* 服务状态条 */
.status-bar {
  position: fixed;
  left: 20px;
  right: 20px;
  bottom: calc(20px + env(safe-area-inset-bottom));
  z-index: 20;
  max-width: 360px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 16px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(20, 42, 91, 0.06);
  backdrop-filter: blur(12px);
  box-shadow: 0 4px 16px rgba(20, 42, 91, 0.08);
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
  background: #07c160;
}

.status-text {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  color: #2a3142;
  line-height: 1.4;
}

.status-retry {
  flex-shrink: 0;
  padding: 4px 12px;
  border-radius: 12px;
  font-size: 12px;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  border: 1px solid rgba(7, 193, 96, 0.35);
}

.status-success .status-dot {
  background: #07c160;
}

.status-loading .status-dot {
  background: #ffc300;
  animation: status-blink 1s ease-in-out infinite;
}

.status-warn .status-dot {
  background: #ffc300;
}

.status-error .status-dot {
  background: #fa5151;
}

@keyframes status-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}
