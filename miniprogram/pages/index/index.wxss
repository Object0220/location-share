/** 首页样式 - C端车主入口 */
.page {
  min-height: 100vh;
  background: linear-gradient(160deg, #0e1633 0%, #142a5c 45%, #1b6fb8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 28px;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

/* 柔和彩色光晕 */
.bg-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  opacity: 0.55;
  mix-blend-mode: screen;
}

.bg-blob-1 {
  width: 320px;
  height: 320px;
  background: radial-gradient(circle at 30% 30%, #00e0ff, #1e90ff);
  top: -90px;
  right: -100px;
}

.bg-blob-2 {
  width: 280px;
  height: 280px;
  background: radial-gradient(circle at 30% 30%, #19f0a8, #07c160);
  bottom: -40px;
  left: -90px;
}

.bg-blob-3 {
  width: 220px;
  height: 220px;
  background: radial-gradient(circle at 30% 30%, #ffd166, #ff8e53);
  top: 40%;
  left: 55%;
  opacity: 0.4;
}

/* 半透明描边光环 */
.bg-circle {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.04);
}

.bg-circle-1 {
  width: 300px;
  height: 300px;
  top: -80px;
  right: -80px;
}

.bg-circle-2 {
  width: 200px;
  height: 200px;
  bottom: 60px;
  left: -60px;
}

/* 细微网格点缀 */
.bg-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  background-size: 28px 28px;
  opacity: 0.6;
}

/* 顶部品牌区 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 110px;
  padding-bottom: 36px;
  text-align: center;
  z-index: 1;
}

.hero-badge {
  width: 68px;
  height: 68px;
  border-radius: 22px;
  background: rgba(7, 193, 96, 0.16);
  border: 1px solid rgba(7, 193, 96, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  backdrop-filter: blur(8px);
  box-shadow: 0 8px 24px rgba(7, 193, 96, 0.18);
}

.hero-icon {
  font-size: 34px;
  line-height: 1;
}

.header-title {
  font-size: 34px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1px;
  margin-bottom: 10px;
}

.header-subtitle {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.5;
}

/* 主功能区 */
.main-content {
  width: 100%;
  max-width: 360px;
  z-index: 1;
}

.entry-card {
  position: relative;
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 22px;
  padding: 22px 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.entry-card--hover {
  transform: scale(0.975);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
}

.entry-card:active {
  transform: scale(0.975);
}

.entry-icon {
  width: 54px;
  height: 54px;
  border-radius: 16px;
  background: rgba(7, 193, 96, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  flex-shrink: 0;
}

.entry-body {
  flex: 1;
  min-width: 0;
}

.entry-title {
  font-size: 18px;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 6px;
}

.entry-desc {
  font-size: 13px;
  color: #999;
  display: block;
  line-height: 1.4;
}

.entry-arrow {
  font-size: 26px;
  color: #c8c8c8;
  flex-shrink: 0;
}

.entry-hint {
  display: block;
  text-align: center;
  margin-top: 16px;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.45);
}

/* 服务状态条 */
.status-bar {
  position: fixed;
  left: 20px;
  right: 20px;
  bottom: calc(20px + env(safe-area-inset-bottom));
  z-index: 20;
  max-width: 360px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 16px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(12px);
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
  background: #07c160;
}

.status-text {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.4;
}

.status-retry {
  flex-shrink: 0;
  padding: 4px 12px;
  border-radius: 12px;
  font-size: 12px;
  color: #07c160;
  background: rgba(7, 193, 96, 0.18);
  border: 1px solid rgba(7, 193, 96, 0.45);
}

.status-success .status-dot {
  background: #07c160;
}

.status-loading .status-dot {
  background: #ffc300;
  animation: status-blink 1s ease-in-out infinite;
}

.status-warn .status-dot {
  background: #ffc300;
}

.status-error .status-dot {
  background: #fa5151;
}

@keyframes status-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}
