/** 首页样式 */
.page {
  min-height: 100vh;
  background: linear-gradient(160deg, #0e1633 0%, #142a5c 45%, #1b6fb8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24px;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: hidden;
}

/* 柔和彩色光晕 */
.bg-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  opacity: 0.55;
  mix-blend-mode: screen;
}

.bg-blob-1 {
  width: 320px;
  height: 320px;
  background: radial-gradient(circle at 30% 30%, #00e0ff, #1e90ff);
  top: -90px;
  right: -100px;
}

.bg-blob-2 {
  width: 280px;
  height: 280px;
  background: radial-gradient(circle at 30% 30%, #19f0a8, #07c160);
  bottom: -40px;
  left: -90px;
}

.bg-blob-3 {
  width: 220px;
  height: 220px;
  background: radial-gradient(circle at 30% 30%, #ffd166, #ff8e53);
  top: 40%;
  left: 55%;
  opacity: 0.4;
}

/* 半透明描边光环 */
.bg-circle {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.04);
}

.bg-circle-1 {
  width: 300px;
  height: 300px;
  top: -80px;
  right: -80px;
}

.bg-circle-2 {
  width: 200px;
  height: 200px;
  bottom: 60px;
  left: -60px;
}

/* 细微网格点缀 */
.bg-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  background-size: 28px 28px;
  opacity: 0.6;
}

/* 头部 */
.header {
  padding-top: 120px;
  padding-bottom: 40px;
  text-align: center;
  z-index: 1;
}

.header-title {
  font-size: 36px;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8px;
}

.header-subtitle {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.7);
}

/* 主功能区 */
.main-content {
  width: 100%;
  max-width: 340px;
  z-index: 1;
}

.action-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  cursor: pointer;
  transition: transform 0.2s;
}

.action-card:active {
  transform: scale(0.98);
}

.action-icon {
  width: 52px;
  height: 52px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  flex-shrink: 0;
}

.join-icon {
  background: rgba(64, 158, 255, 0.12);
}

.action-text {
  flex: 1;
}

.action-title {
  font-size: 17px;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 4px;
}

.action-desc {
  font-size: 13px;
  color: #999;
  display: block;
}

.action-arrow {
  font-size: 24px;
  color: #ccc;
}
