/** 地图页样式 */
.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.map {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
}

/* 顶部信息栏 */
.info-bar {
  position: absolute;
  top: 200rpx;
  left: 16px;
  right: 16px;
  z-index: 10;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 14px;
  padding: 10px 14px;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.12);
}

.info-bar-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10px;
}

.partner-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid #fff;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

.partner-detail {
  flex: 1;
  min-width: 0;
}

.partner-name {
  font-size: 15px;
  font-weight: 600;
  color: #333;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.partner-status {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 2px;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.status-dot.online {
  background: #07c160;
  box-shadow: 0 0 6px rgba(7, 193, 96, 0.6);
}

.status-dot.offline {
  background: #ccc;
}

.status-text {
  font-size: 12px;
  color: #999;
}

.update-time {
  font-size: 11px;
  color: #bbb;
  margin-left: 2px;
}

.info-bar-right {
  flex-shrink: 0;
  padding-left: 12px;
}

/* 网络状态提示 */
.status-overlay {
  position: absolute;
  top: 100px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  border-radius: 24px;
  padding: 10px 20px;
}

.status-overlay-content {
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-overlay .loading-dots {
  display: flex;
  gap: 3px;
}

.status-overlay .dot {
  width: 6px;
  height: 6px;
  background: #ffc300;
  border-radius: 50%;
  animation: bounce 1.4s infinite;
}

.status-overlay .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.status-overlay .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.status-overlay-text {
  font-size: 13px;
  color: #fff;
}

/* 定位失败提示 */
.location-error {
  position: absolute;
  top: 100px;
  left: 24px;
  right: 24px;
  z-index: 20;
  background: rgba(250, 81, 81, 0.9);
  border-radius: 12px;
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.location-error-icon {
  font-size: 16px;
}

.location-error-text {
  flex: 1;
  font-size: 13px;
  color: #fff;
  min-width: 0;
}

.location-retry-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 14px;
  padding: 4px 14px;
  font-size: 12px;
  color: #fff;
  line-height: 1.5;
}

/* 对方位置未更新提示 */
.stale-notice {
  position: absolute;
  bottom: 120px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 16px;
  padding: 8px 16px;
}

.stale-notice text {
  font-size: 12px;
  color: #ffc300;
}

/* 底部控制 */
.bottom-controls {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 16px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, rgba(0,0,0,0.05) 0%, transparent 80%);
  pointer-events: none;
}

.bottom-controls > view,
.bottom-controls > button {
  pointer-events: auto;
}

.btn-end-share {
  background: var(--danger);
  color: #fff;
  border: none;
  border-radius: 25px;
  padding: 14px 28px;
  font-size: 15px;
  font-weight: 600;
  box-shadow: 0 4px 16px rgba(250, 81, 81, 0.4);
  line-height: 1.5;
}

.btn-end-share:active {
  transform: scale(0.95);
}

/* 等待栏 — 替换全屏遮罩，嵌入 info-bar 显示 */
.waiting-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
}

.waiting-dots {
  display: flex;
  gap: 4px;
  flex-shrink: 0;
}

.waiting-dots .dot {
  width: 8px;
  height: 8px;
  background: var(--primary);
  border-radius: 50%;
  animation: bounce 1.4s infinite;
}

.waiting-dots .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.waiting-dots .dot:nth-child(3) {
  animation-delay: 0.4s;
}

.waiting-text {
  flex: 1;
  min-width: 0;
}

.waiting-text .waiting-title {
  font-size: 15px;
  font-weight: 600;
  color: #333;
  display: block;
}

.waiting-text .waiting-hint {
  font-size: 11px;
  color: #999;
  display: block;
  margin-top: 1px;
}

.share-code-tag {
  flex-shrink: 0;
  background: var(--primary);
  border-radius: 10px;
  padding: 8px 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
  cursor: pointer;
}

.share-code-tag:active {
  opacity: 0.8;
}

.share-code-text {
  font-size: 20px;
  font-weight: 800;
  color: #fff;
  letter-spacing: 3px;
}

.share-code-hint {
  font-size: 9px;
  color: rgba(255, 255, 255, 0.75);
}

/* 信息卡片 */
.info-card {
  position: absolute;
  top: 200rpx;
  left: 16px;
  right: 16px;
  z-index: 10;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  border-radius: 14px;
  padding: 12px 14px;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.12);
}

.info-card-row {
  display: flex;
  align-items: center;
}

.info-card-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10px;
}

.info-card-right {
  flex-shrink: 0;
  padding-left: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.distance-text { 
  font-size: 18px; 
  font-weight: 700; 
  color: var(--primary); 
} 

.nav-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 6px 12px;
  border-radius: 12px;
  background: rgba(7, 193, 96, 0.1);
}

.nav-btn:active {
  transform: scale(0.92);
}

.nav-btn-icon {
  font-size: 20px;
  line-height: 1;
}

.nav-btn-text {
  font-size: 11px;
  font-weight: 600;
  color: var(--primary);
}

.info-card-divider {
  height: 1px;
  background: #f0f0f0;
  margin: 10px -2px 8px;
}

.info-card-addr {
  display: flex;
  align-items: center;
  gap: 10px;
}

.addr-icon {
  font-size: 18px;
  flex-shrink: 0;
}

.addr-text {
  flex: 1;
  min-width: 0;
}

.addr-name {
  font-size: 14px;
  font-weight: 500;
  color: #333;
  display: block;
}

.addr-detail {
  font-size: 11px;
  color: #999;
  display: block;
  margin-top: 1px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.addr-coord {
  font-size: 10px;
  color: #bbb;
  display: block;
  margin-top: 1px;
}

.addr-dist {
  font-size: 14px;
  font-weight: 700;
  color: #f5a623;
  flex-shrink: 0;
}

/* 司机主动结束共享 → 结束态全屏覆盖 */
.ended-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ended-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 48px;
  text-align: center;
}

.ended-icon {
  font-size: 56px;
  margin-bottom: 20px;
}

.ended-title {
  font-size: 22px;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12px;
}

.ended-desc {
  font-size: 14px;
  color: #999;
  margin-bottom: 40px;
}

.ended-btn {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 25px;
  padding: 14px 56px;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.5;
}

.ended-btn:active {
  transform: scale(0.95);
}
