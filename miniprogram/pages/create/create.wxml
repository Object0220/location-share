<!-- 等待页 - 由 App 传入参数自动创建救援房间 -->
<view class="page">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="bg-blob bg-blob-1"></view>
    <view class="bg-blob bg-blob-2"></view>
    <view class="bg-blob bg-blob-3"></view>
    <view class="bg-circle bg-circle-1"></view>
    <view class="bg-circle bg-circle-2"></view>
    <view class="bg-grid"></view>
  </view>

  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="onBack">
    <text class="back-icon">‹</text>
  </view>

  <!-- 自动创建房间状态 -->
  <view class="top-section">
    <view class="avatar-circle">
      <text class="avatar-icon">🚛</text>
    </view>
    <text class="page-title">创建救援房间</text>
    <text class="page-desc">正在为您创建救援房间，请稍候...</text>
  </view>

  <view class="waiting-section">
    <view class="pulse-ring"></view>
    <view class="waiting-dots">
      <view class="wdot"></view>
      <view class="wdot"></view>
      <view class="wdot"></view>
    </view>
    <text class="waiting-text">正在创建救援房间...</text>
  </view>
</view>
