/** ===== 等待页样式 ===== */
.page {
  min-height: 100vh;
  background: linear-gradient(160deg, #0e1633 0%, #142a5c 45%, #1b6fb8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 28px;
  position: relative;
  overflow: hidden;
}

/* ---- 背景装饰 ---- */
.bg-decoration {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

/* 柔和彩色光晕 */
.bg-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  opacity: 0.55;
  mix-blend-mode: screen;
}

.bg-blob-1 {
  width: 320px;
  height: 320px;
  background: radial-gradient(circle at 30% 30%, #00e0ff, #1e90ff);
  top: -90px;
  right: -100px;
}

.bg-blob-2 {
  width: 280px;
  height: 280px;
  background: radial-gradient(circle at 30% 30%, #19f0a8, #07c160);
  bottom: -40px;
  left: -90px;
}

.bg-blob-3 {
  width: 220px;
  height: 220px;
  background: radial-gradient(circle at 30% 30%, #ffd166, #ff8e53);
  top: 40%;
  left: 55%;
  opacity: 0.4;
}

/* 半透明描边光环 */
.bg-circle {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.04);
}

.bg-circle-1 {
  width: 300px;
  height: 300px;
  top: -80px;
  right: -80px;
}

.bg-circle-2 {
  width: 200px;
  height: 200px;
  bottom: 60px;
  left: -60px;
}

/* 细微网格点缀 */
.bg-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  background-size: 28px 28px;
  opacity: 0.6;
}

/* ---- 返回按钮 ---- */
.back-btn {
  position: absolute;
  top: 54px;
  left: 12px;
  z-index: 10;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(6px);
}

.back-icon {
  font-size: 26px;
  color: #fff;
  line-height: 1;
}

/* ---- 顶部区域 ---- */
.top-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100px;
  padding-bottom: 32px;
}

.avatar-circle {
  width: 64px;
  height: 64px;
  border-radius: 20px;
  background: rgba(7, 193, 96, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  backdrop-filter: blur(8px);
}

.avatar-circle.success {
  background: rgba(7, 193, 96, 0.2);
  box-shadow: 0 0 30px rgba(7, 193, 96, 0.15);
}

.avatar-icon {
  font-size: 30px;
}

.page-title {
  font-size: 26px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8px;
  letter-spacing: 0.5px;
}

.page-desc {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  line-height: 1.6;
  max-width: 280px;
}

/* ---- 等待动画 ---- */
.waiting-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  margin-top: 32px;
  margin-bottom: 32px;
  position: relative;
}

.pulse-ring {
  position: absolute;
  top: -8px;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 2px solid rgba(7, 193, 96, 0.3);
  animation: pulse-ring 2s ease-out infinite;
}

@keyframes pulse-ring {
  0% {
    transform: scale(0.8);
    opacity: 0.6;
  }
  100% {
    transform: scale(2.2);
    opacity: 0;
  }
}

.waiting-dots {
  display: flex;
  gap: 8px;
}

.wdot {
  width: 10px;
  height: 10px;
  background: #07c160;
  border-radius: 50%;
  animation: wdot-bounce 1.4s ease-in-out infinite;
}

.wdot:nth-child(2) {
  animation-delay: 0.2s;
}

.wdot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes wdot-bounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.3;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.waiting-text {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 400;
}


