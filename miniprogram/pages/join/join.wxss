/** ===== 加入页样式（浅色简约，与首页一致） ===== */
.page {
  min-height: 100vh;
  background: linear-gradient(160deg, #f6f9ff 0%, #eef4fc 45%, #e9f7f0 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 28px;
  position: relative;
  overflow: hidden;
}

/* ---- 背景装饰 ---- */
.bg-decoration {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

/* 柔和彩色光晕（浅底低饱和） */
.bg-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(70px);
  opacity: 0.5;
}

.bg-blob-1 {
  width: 300px;
  height: 300px;
  background: radial-gradient(circle at 30% 30%, #bcdcff, #9ec9ff);
  top: -100px;
  right: -110px;
}

.bg-blob-2 {
  width: 260px;
  height: 260px;
  background: radial-gradient(circle at 30% 30%, #b6f0d4, #8fe3bd);
  bottom: -50px;
  left: -100px;
}

.bg-blob-3 {
  width: 220px;
  height: 220px;
  background: radial-gradient(circle at 30% 30%, #ffe6b0, #ffd089);
  top: 42%;
  left: 52%;
  opacity: 0.4;
}

/* 半透明描边光环 */
.bg-circle {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(20, 42, 91, 0.06);
  background: rgba(255, 255, 255, 0.4);
}

.bg-circle-1 {
  width: 300px;
  height: 300px;
  top: -80px;
  right: -80px;
}

.bg-circle-2 {
  width: 200px;
  height: 200px;
  bottom: 60px;
  left: -60px;
}

/* 细微网格点缀 */
.bg-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(20, 42, 91, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(20, 42, 91, 0.04) 1px, transparent 1px);
  background-size: 28px 28px;
  opacity: 0.7;
}

/* ---- 返回按钮 ---- */
.back-btn {
  position: absolute;
  top: 54px;
  left: 12px;
  z-index: 10;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(20, 42, 91, 0.06);
  backdrop-filter: blur(6px);
}

.back-icon {
  font-size: 26px;
  color: #1a2433;
  line-height: 1;
}

/* ---- 顶部区域 ---- */
.top-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100px;
  padding-bottom: 36px;
}

.avatar-circle {
  width: 64px;
  height: 64px;
  border-radius: 20px;
  background: rgba(7, 193, 96, 0.12);
  border: 1px solid rgba(7, 193, 96, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  backdrop-filter: blur(8px);
  box-shadow: 0 8px 24px rgba(7, 193, 96, 0.12);
}

.avatar-icon {
  font-size: 30px;
}

.page-title {
  font-size: 26px;
  font-weight: 700;
  color: #1a2433;
  margin-bottom: 8px;
  letter-spacing: 0.5px;
}

.page-desc {
  font-size: 14px;
  color: rgba(26, 42, 91, 0.55);
  text-align: center;
  line-height: 1.6;
  max-width: 280px;
}

/* ---- 输入卡片 ---- */
.input-card {
  background: #ffffff;
  border: 1px solid rgba(20, 42, 91, 0.05);
  border-radius: 20px;
  padding: 24px 32px;
  width: 100%;
  max-width: 320px;
  text-align: center;
  box-shadow: 0 8px 26px rgba(20, 42, 91, 0.08);
  margin-bottom: 28px;
}

.code-slots {
  display: flex;
  justify-content: center;
  gap: 12px;
}

.code-slot {
  width: 56px;
  height: 66px;
  background: #f5f7fb;
  border: 1.5px solid rgba(20, 42, 91, 0.1);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.25s ease;
}

.code-slot.filled {
  background: rgba(7, 193, 96, 0.1);
  border-color: rgba(7, 193, 96, 0.4);
  box-shadow: 0 0 20px rgba(7, 193, 96, 0.08);
}

.code-slot.active {
  border-color: #07c160;
  box-shadow: 0 0 16px rgba(7, 193, 96, 0.2);
}

.slot-text {
  font-size: 28px;
  font-weight: 800;
  color: #1a2433;
  letter-spacing: 1px;
}

.slot-cursor {
  position: absolute;
  bottom: 12px;
  width: 2px;
  height: 20px;
  background: #07c160;
  border-radius: 1px;
  animation: cursor-blink 1s step-end infinite;
}

@keyframes cursor-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.slot-label {
  font-size: 12px;
  color: rgba(26, 42, 91, 0.4);
  margin-top: 14px;
}

/* ---- 数字键盘 ---- */
.keyboard-area {
  width: 100%;
  max-width: 300px;
}

.kbd-row {
  display: flex;
  justify-content: center;
  gap: 14px;
  margin-bottom: 10px;
}

.kbd-key {
  width: 76px;
  height: 50px;
  background: #ffffff;
  border: 1px solid rgba(20, 42, 91, 0.06);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 500;
  color: #1a2433;
  box-shadow: 0 2px 8px rgba(20, 42, 91, 0.06);
  transition: background 0.15s;
}

.kbd-key:active {
  background: #eef2f8;
}

.kbd-empty {
  background: transparent;
  border: none;
  box-shadow: none;
  pointer-events: none;
}

.kbd-delete-icon {
  font-size: 20px;
  color: rgba(26, 42, 91, 0.5);
}

/* ---- 底部操作 ---- */
.bottom-actions {
  width: 100%;
  text-align: center;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  margin-top: 8px;
  margin-bottom: 20px;
}

.clear-btn, .paste-btn {
  font-size: 13px;
  color: rgba(26, 42, 91, 0.45);
  padding: 6px 12px;
}

/* ---- 内嵌加载 ---- */
.inline-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 14px 24px;
  background: #ffffff;
  border: 1px solid rgba(20, 42, 91, 0.06);
  border-radius: 14px;
  box-shadow: 0 4px 16px rgba(20, 42, 91, 0.08);
  width: 100%;
  max-width: 320px;
  margin-bottom: 40px;
  animation: fadeInUp 0.3s ease;
}

.loading-spinner {
  width: 20px;
  height: 20px;
  border: 2px solid rgba(20, 42, 91, 0.12);
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  flex-shrink: 0;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 14px;
  color: rgba(26, 42, 91, 0.6);
}

/* ---- 错误提示 ---- */
.error-toast {
  position: fixed;
  bottom: 160px;
  left: 28px;
  right: 28px;
  background: rgba(250, 81, 81, 0.92);
  backdrop-filter: blur(12px);
  border-radius: 14px;
  padding: 14px 20px;
  text-align: center;
  z-index: 40;
  animation: fadeInUp 0.3s ease;
}

.error-toast text {
  font-size: 14px;
  color: #fff;
  line-height: 1.5;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
