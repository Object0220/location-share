/** 地图页样式 */
.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.map {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
}

/* 信息卡片（司机信息 + 救援地址） */
.info-card {
  position: absolute;
  top: 200rpx;
  left: 16px;
  right: 16px;
  z-index: 10;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 14px;
  padding: 12px 14px;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.12);
}

.info-card-row {
  display: flex;
  align-items: center;
}

.info-card-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10px;
}

.info-card-right {
  flex-shrink: 0;
  padding-left: 12px;
}

.info-card-divider {
  height: 1px;
  background: #f0f0f0;
  margin: 10px -2px 8px;
}

/* 救援地址行 */
.info-card-addr {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
}

.info-card-addr:active {
  opacity: 0.7;
}

.addr-icon {
  font-size: 18px;
  flex-shrink: 0;
}

.addr-text {
  flex: 1;
  min-width: 0;
}

.addr-name {
  font-size: 14px;
  font-weight: 500;
  color: #333;
  display: block;
}

.addr-detail {
  font-size: 11px;
  color: #999;
  display: block;
  margin-top: 1px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.addr-coord {
  font-size: 10px;
  color: #bbb;
  display: block;
  margin-top: 1px;
}

.addr-edit {
  font-size: 12px;
  color: var(--primary);
  flex-shrink: 0;
}

.addr-arrow {
  font-size: 16px;
  color: #ccc;
  flex-shrink: 0;
}

.partner-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid #fff;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

.partner-detail {
  flex: 1;
  min-width: 0;
}

.partner-name {
  font-size: 15px;
  font-weight: 600;
  color: #333;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.partner-status {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 2px;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.status-dot.online {
  background: #07c160;
  box-shadow: 0 0 6px rgba(7, 193, 96, 0.6);
}

.status-dot.offline {
  background: #ccc;
}

.status-dot.stale {
  background: #ffc300;
  box-shadow: 0 0 6px rgba(255, 195, 0, 0.6);
}

.status-text {
  font-size: 12px;
  color: #999;
}

.update-time {
  font-size: 11px;
  color: #bbb;
  margin-left: 2px;
}

.info-bar-right {
  flex-shrink: 0;
  padding-left: 12px;
}

.distance-text {
  font-size: 18px;
  font-weight: 700;
  color: var(--primary);
}

/* 网络状态提示 */
.status-overlay {
  position: absolute;
  top: 100px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  border-radius: 24px;
  padding: 10px 20px;
}

.status-overlay-content {
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-overlay .loading-dots {
  display: flex;
  gap: 3px;
}

.status-overlay .dot {
  width: 6px;
  height: 6px;
  background: #ffc300;
  border-radius: 50%;
  animation: bounce 1.4s infinite;
}

.status-overlay .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.status-overlay .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.status-overlay-text {
  font-size: 13px;
  color: #fff;
}

/* 定位失败提示 */
.location-error {
  position: absolute;
  top: 100px;
  left: 24px;
  right: 24px;
  z-index: 20;
  background: rgba(250, 81, 81, 0.9);
  border-radius: 12px;
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.location-error-icon {
  font-size: 16px;
}

.location-error-text {
  flex: 1;
  font-size: 13px;
  color: #fff;
  min-width: 0;
}

.location-retry-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 14px;
  padding: 4px 14px;
  font-size: 12px;
  color: #fff;
  line-height: 1.5;
}

/* 对方位置未更新提示 */
.stale-notice {
  position: absolute;
  bottom: 120px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 16px;
  padding: 8px 16px;
}

.stale-notice text {
  font-size: 12px;
  color: #ffc300;
}

/* 底部控制 */
.bottom-controls {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 16px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, rgba(0,0,0,0.05) 0%, transparent 80%);
  pointer-events: none;
}

.bottom-controls > view,
.bottom-controls > button {
  pointer-events: auto;
}

.btn-end-share {
  background: var(--danger);
  color: #fff;
  border: none;
  border-radius: 25px;
  padding: 14px 28px;
  font-size: 15px;
  font-weight: 600;
  box-shadow: 0 4px 16px rgba(250, 81, 81, 0.4);
  line-height: 1.5;
}

.btn-end-share:active {
  transform: scale(0.95);
}


