<!-- 客户地图页 -->
<view class="page">
  <map
    id="map"
    class="map"
    latitude="{{myLocation.latitude || 39.9042}}"
    longitude="{{myLocation.longitude || 116.4074}}"
    scale="{{mapScale}}"
    markers="{{markers}}"
    polyline="{{polyline}}"
    show-location="{{true}}"
    enable-satellite="{{satelliteMode}}"
    style="width: 100%; height: 100vh;"
    bindscalechange="onScaleChange"
    bindregionchange="onRegionChange">
  </map>

  <!-- 信息卡：司机信息 + 救援地址 -->
  <view class="info-card">
    <view class="info-card-row">
      <view class="info-card-left">
        <image class="partner-avatar" src="{{'/images/ic_js.svg'}}" mode="aspectFill" />
        <view class="partner-detail">
          <text class="partner-name">{{partnerInfo.nickName || '司机'}}</text>
          <view class="partner-status">
            <view class="status-dot {{partnerStale ? 'stale' : (partnerOnline ? 'online' : 'offline')}}"></view>
            <text class="status-text">{{partnerStale ? '暂未更新' : (partnerOnline ? '在线' : '离线')}}</text>
            <text class="update-time" wx:if="{{partnerLastUpdate}}">· {{partnerLastUpdate}}</text>
          </view>
        </view>
      </view>
      <view class="info-card-right">
        <text class="distance-text" wx:if="{{distance !== null}}">{{distance}}</text>
      </view>
    </view>

    <!-- 分割线 + 救援地址行 -->
    <view class="info-card-divider" wx:if="{{destination}}"></view>
    <view class="info-card-addr" wx:if="{{destination}}" bindtap="onSetDestination">
      <text class="addr-icon">🚩</text>
      <view class="addr-text">
        <text class="addr-name">{{destination.name}}</text>
        <text class="addr-detail">{{destination.address}}</text>
        <text class="addr-coord">经度 {{destination.longitude}}  纬度 {{destination.latitude}}</text>
      </view>
      <text class="addr-edit">修改</text>
    </view>
    <view class="info-card-addr info-card-addr--empty" wx:else bindtap="onSetDestination">
      <view class="addr-pulse">
        <text class="addr-icon">📍</text>
      </view>
      <view class="addr-text">
        <text class="addr-name">设置救援地址</text>
        <text class="addr-detail">点击此处，让司机知道去哪里救援</text>
      </view>
      <view class="addr-action">
        <text class="addr-action-text">去设置</text>
        <text class="addr-arrow">→</text>
      </view>
    </view>
  </view>

  <view class="location-error" wx:if="{{locationError}}">
    <text class="location-error-icon">⚠️</text>
    <text class="location-error-text">{{locationError}}</text>
    <button class="location-retry-btn" bindtap="onRetryLocation">重试</button>
  </view>

  <view class="stale-notice" wx:if="{{partnerStale}}">
    <text>⏳ 司机位置暂未更新</text>
  </view>

  <!-- ══════════ 6. 已结束态：全屏覆盖层 ══════════ -->
  <!-- shareEnded：客户退出房间 / 司机结束共享后停留本页，不自动返回 -->
  <view class="ended-overlay" wx:if="{{shareEnded}}">
    <view class="ended-card">
      <view class="ended-icon">🏁</view>
      <text class="ended-title">救援已结束</text>
      <text class="ended-desc">车主端“位置共享已关闭，如有需要请联系技师沟通。</text>
      <button class="ended-btn" bindtap="onEndedGoHome">返回首页</button>
    </view>
  </view>

  <view class="bottom-controls safe-area-bottom" wx:if="{{!shareEnded}}">
    <button class="btn-end-share" bindtap="onEndShare">退出房间</button>
  </view>
</view>
